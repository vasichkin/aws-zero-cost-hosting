# Copy to backend.hcl (gitignored) and adjust after bootstrap.
# Values must match infra/bootstrap/terraform.tfvars: state_bucket_name, aws_region.
#
#   cp backend.hcl.example backend.hcl
#   tofu init -reconfigure -backend-config=backend.hcl

bucket = "minimal-aws-tofu-state"
region = "eu-west-3"
